# Copy to .env and fill in. Restart Expo after changes.
# Same Clerk application as the Next.js provider console (publishable key only).
# Used for native iOS/Android, mobile web (expo start --web), and static export.

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional — defaults to https://www.oyadrop.com/api/external/oya-eat-provider
# EXPO_PUBLIC_OYADROP_BASE_URL=
